# JaIre environment variables
# Replace placeholder values with your own local secrets and credentials.
# Do not commit real secrets to version control.

NODE_ENV=development
PORT=5173
BASE_PATH=/

# App / gateway
LOG_LEVEL=info
API_BASE_URL=http://localhost:8080
PYTHON_API_URL=http://localhost:8000
MPC_SIDECAR_PORT=9000
SESSION_SECRET=replace_with_local_session_secret

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jaire
POSTGRES_URL=postgresql://user:password@localhost:5432/jaire
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jaire
DB_USER=jaire_user
DB_PASSWORD=replace_with_local_db_password

# Solana / blockchain
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
JAIRE_TREASURY_PRIVATE_KEY=replace_with_treasury_private_key
JAIRE_VAULT_PRIVATE_KEY=replace_with_vault_private_key
JAIRE_TEST_MINT=7egxbd4d6tsPsRKJU8v74PKFnis4YKhbQgKX9HDCpR8S
TREASURY_PUBKEY=JDtjhBDwv3WwJpQR1LAcC9kTCwr4sbZhdEYVmKPcxRE
JAIRE_VAULT_ADDRESS=replace_with_vault_public_address
NGN_USDC_RATE=1600
KAMINO_SIMULATED_APY=0.05

# Web3Auth / auth
WEB3AUTH_CLIENT_ID=replace_with_web3auth_client_id
WEB3AUTH_NODE_FACTOR_KEY=replace_with_web3auth_node_factor_key
WEB3AUTH_NETWORK=sapphire_devnet
WEB3AUTH_GOOGLE_VERIFIER=replace_with_google_verifier
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id

# AI / OpenAI
OPENAI_API_KEY=replace_with_openai_api_key
AI_INTEGRATIONS_OPENAI_API_KEY=replace_with_openai_api_key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Payments
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=replace_with_paystack_secret_key
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
ROQQU_WEBHOOK_SECRET=replace_with_roqqu_webhook_secret
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret

# Legacy / misc
TEST_MODE_ENABLED=true
DEBUG=false
REPL_ID=

# Optional external providers
TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
SENDGRID_API_KEY=replace_with_sendgrid_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password

# Security / crypto
JWT_SECRET=replace_with_jwt_secret
COOKIE_SECRET=replace_with_cookie_secret

# Asset / upload config
UPLOAD_PATH=./public/uploads
MAX_UPLOAD_SIZE=52428800

# Integration flags
ENABLE_MQTT=false
MQTT_BROKER_URL=broker.hivemq.com
MQTT_PORT=1883

# Feature flags
ENABLE_BAIRE=false
ENABLE_KAMINO=false
ENABLE_ESCROW=false
