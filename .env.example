# -----------------------------------------------------------------------------
# JaIre workspace environment template
# scripts/dev-up.sh copies this file to .env on first run.
# Replace placeholders only when enabling integrations that need real credentials.
# -----------------------------------------------------------------------------

# Core application config
PORT=8000
DEBUG=false
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jaire
JWT_SECRET=replace-with-a-long-random-secret

# Python FastAPI service / Solana config
JAIRE_TREASURY_PRIVATE_KEY=replace-with-your-solana-private-key
TREASURY_PUBKEY=replace-with-solana-treasury-address
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
JAIRE_VAULT_ADDRESS=replace-with-vault-address
JAIRE_VAULT_PRIVATE_KEY=replace-with-vault-private-key
NGN_USDC_RATE=1600
PAYMENT_PROVIDER=paystack
TEST_MODE_ENABLED=true

# Web3Auth / MPC sidecar
WEB3AUTH_CLIENT_ID=replace-with-web3auth-client-id
WEB3AUTH_NODE_FACTOR_KEY=replace-with-web3auth-node-factor-key
WEB3AUTH_NETWORK=sapphire_devnet
WEB3AUTH_GOOGLE_VERIFIER=replace-with-web3auth-google-verifier
GOOGLE_CLIENT_ID=replace-with-google-client-id
MPC_SIDECAR_PORT=9000
MPC_SIDECAR_URL=http://localhost:9000
PYTHON_API_URL=http://localhost:8000

# AI integrations
OPENAI_API_KEY=replace-with-openai-api-key
AI_INTEGRATIONS_OPENAI_API_KEY=replace-with-openai-api-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
STT_ELEVENLLABS_API_KEY=replace-with-elevenlabs-api-key
TTS_ELEVENLLABS_API_KEY=replace-with-elevenlabs-api-key

# Payment providers
PAYSTACK_SECRET_KEY=replace-with-paystack-secret-key
PAYSTACK_TEST_API_KEY=replace-with-paystack-test-key
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
ROQQU_WEBHOOK_SECRET=replace-with-roqqu-webhook-secret

# API and runtime settings
JAIRE_ADMIN_TOKEN=replace-with-a-local-admin-token
JAIRE_PUBLIC_URL=http://localhost:8080
JAIRE_TEST_MINT=7egxbd4d6tsPsRKJU8v74PKFnis4YKhbQgKX9HDCpR8S
SESSION_SECRET=replace-with-a-long-random-session-secret
NODE_ENV=development
LOG_LEVEL=info
BASE_PATH=/
REPL_ID=
REPLIT_DEV_DOMAIN=
KAMINO_SIMULATED_APY=0.05
